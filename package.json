{
  "name": "booking-intake-vault",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build:web": "vite build --config frontend/vite.config.ts",
    "build": "npm run build:web && cargo build --release",
    "check": "svelte-check --workspace frontend --fail-on-warnings",
    "test:web": "vitest run --config frontend/vite.config.ts",
    "test:e2e": "npm run build:web && playwright test",
    "test": "npm run build:web && npm run test:web && cargo test && npm run test:e2e",
    "start": "cargo run --release"
  },
  "dependencies": {
    "@azure/msal-browser": "4.18.0",
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "svelte": "5.56.10",
    "vite": "7.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "svelte-check": "^4.3.4",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
